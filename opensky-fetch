#!/bin/bash

# Fetch OpenSky Network state vectors for a lat/lon bounding box.
#
# Usage: opensky-fetch <lamin> <lomin> <lamax> <lomax> [<lamin> <lomin> <lamax> <lomax> ...]
#
# Prints {"time":…,"authenticated":…,"remaining":…,"states":[…]}, or {"error":"…"}
# — exiting 0 either way so the panel can render the reason. "remaining" is the
# credit balance OpenSky reports, or null if it said nothing. A refusal for rate
# limiting carries "limited": true and "retryAfter" in seconds.
#
# Credentials are optional (4000 requests/day instead of 400) and are read from
# the panel's settings file, which is kept at 0600 while it holds them.

set -uo pipefail

readonly TOKEN_URL="https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token"
readonly STATES_URL="https://opensky-network.org/api/states/all"
readonly STATE_DIR="$HOME/.local/state/omarchy/settings"
readonly CONFIG_FILE="${OMARCHY_RADAR_CONFIG:-$STATE_DIR/flight-radar.json}"

readonly CACHE_DIR="${XDG_RUNTIME_DIR:-/tmp}/omarchy-flight-radar"
readonly TOKEN_FILE="$CACHE_DIR/token"

die() {
  jq -cn --arg m "$1" '{error: $m}'
  exit 0
}

die_limited() {
  jq -cn --arg m "$1" --argjson retry "${RETRY_AFTER:-null}" \
    '{error: $m, limited: true, retryAfter: $retry}'
  exit 0
}

(( $# >= 4 && $# % 4 == 0 )) ||
  die "opensky-fetch expects one or more lamin, lomin, lamax, lomax groups"

urlencode() {
  local raw="$1" out="" ch i
  for ((i = 0; i < ${#raw}; i++)); do
    ch=${raw:i:1}
    case $ch in
      [a-zA-Z0-9.~_-]) out+=$ch ;;
      *) out+=$(printf '%%%02X' "'$ch") ;;
    esac
  done
  printf '%s' "$out"
}

read_cached_token() {
  [[ -r $TOKEN_FILE ]] || return 1
  local expiry token
  IFS=$'\t' read -r expiry token <"$TOKEN_FILE" || return 1
  [[ ${expiry:-} =~ ^[0-9]+$ && -n ${token:-} ]] || return 1
  ((expiry > $(date +%s))) || return 1
  printf '%s' "$token"
}

fetch_token() {
  [[ -r $CONFIG_FILE ]] || return 1

  local id secret body response token tmp
  id=$(jq -r '.clientId // .client_id // empty' "$CONFIG_FILE" 2>/dev/null) || return 1
  secret=$(jq -r '.clientSecret // .client_secret // empty' "$CONFIG_FILE" 2>/dev/null) || return 1
  [[ -n $id && -n $secret ]] || return 1

  body="grant_type=client_credentials&client_id=$(urlencode "$id")&client_secret=$(urlencode "$secret")"
  response=$(
    printf 'url = "%s"\nheader = "Content-Type: application/x-www-form-urlencoded"\ndata = "%s"\n' \
      "$TOKEN_URL" "$body" | curl -fsS --max-time 15 --config - 2>/dev/null
  ) || return 1

  token=$(printf '%s' "$response" | jq -r '.access_token // empty' 2>/dev/null)
  [[ -n $token ]] || return 1

  mkdir -p "$CACHE_DIR" 2>/dev/null && chmod 700 "$CACHE_DIR" 2>/dev/null
  tmp=$(mktemp "$CACHE_DIR/token.XXXXXX" 2>/dev/null) || {
    printf '%s' "$token"
    return 0
  }
  chmod 600 "$tmp"
  printf '%s\t%s\n' "$(($(date +%s) + 29 * 60))" "$token" >"$tmp"
  mv -f "$tmp" "$TOKEN_FILE"
  printf '%s' "$token"
}

RESPONSE=""
HTTP_CODE=""
REMAINING=""
RETRY_AFTER=""

# The body, then the status and the two rate-limit headers, one per line, peeled
# off the end. Headers rather than a fixed budget: the same account may be
# feeding another client, and only OpenSky knows what is left. The trailing dot
# is there because an absent header writes an empty line, and command
# substitution would strip it along with the newline, shifting every field.
request_states() {
  local bearer="$1" query="$2" config raw
  config="url = \"$STATES_URL?$query\""
  [[ -n $bearer ]] && config+=$'\n'"header = \"Authorization: Bearer $bearer\""
  raw=$(printf '%s\n' "$config" | curl -sS --max-time 20 --config - 2>/dev/null \
    -w '\n%{http_code}\n%header{x-rate-limit-remaining}\n%header{x-rate-limit-retry-after-seconds}\n.') || {
    RESPONSE=""
    HTTP_CODE=""
    REMAINING=""
    RETRY_AFTER=""
    return 1
  }

  raw="${raw%$'\n'*}"
  RETRY_AFTER="${raw##*$'\n'}"
  raw="${raw%$'\n'*}"
  REMAINING="${raw##*$'\n'}"
  raw="${raw%$'\n'*}"
  HTTP_CODE="${raw##*$'\n'}"
  RESPONSE="${raw%$'\n'*}"

  [[ $REMAINING =~ ^[0-9]+$ ]] || REMAINING=""
  [[ $RETRY_AFTER =~ ^[0-9]+$ ]] || RETRY_AFTER=""

  [[ $HTTP_CODE == 2* ]]
}

token=$(read_cached_token) || token=$(fetch_token) || token=""

readonly LIMIT_MESSAGE="OpenSky's daily request limit is spent — it resets at 00:00 UTC"

request_with_auth() {
  local query="$1"

  request_states "$token" "$query" && return 0
  [[ $HTTP_CODE == 429 ]] && die_limited "$LIMIT_MESSAGE"
  [[ -n $token ]] || return 1

  rm -f "$TOKEN_FILE"
  token=$(fetch_token) || token=""
  request_states "$token" "$query" && return 0
  [[ $HTTP_CODE == 429 ]] && die_limited "$LIMIT_MESSAGE"
  return 1
}

responses=()
while (( $# > 0 )); do
  query="lamin=$1&lomin=$2&lamax=$3&lomax=$4"
  request_with_auth "$query" ||
    die "OpenSky request failed — network error or the service is unavailable"
  responses+=("$RESPONSE")
  shift 4
done

authenticated=false
[[ -n $token ]] && authenticated=true

printf '%s\n' "${responses[@]}" | jq -sc --argjson authed "$authenticated" \
  --argjson remaining "${REMAINING:-null}" \
  '{
    time: ([.[] | (.time // 0)] | max // 0),
    authenticated: $authed,
    remaining: $remaining,
    states: ([.[] | (.states // [])[]] | unique_by(.[0]))
  }' 2>/dev/null ||
  die "OpenSky returned a response that could not be parsed"
