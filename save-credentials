#!/bin/bash

# Store OpenSky API credentials for the radar plugin.
#
# Usage: printf '%s' '{"clientId":"…","clientSecret":"…"}' | save-credentials
#        save-credentials --clear
#
# Credentials arrive on stdin, never as arguments, so they stay out of `ps`, and
# <plugin dir>/opensky.json is created at mode 0600 before anything is written to
# it. .gitignore excludes it; removing the plugin removes it too.

set -uo pipefail

readonly PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly CREDS_FILE="${OMARCHY_RADAR_CREDS:-$PLUGIN_DIR/opensky.json}"

fail() {
  echo "$1" >&2
  exit 1
}

command -v jq >/dev/null || fail "jq is required"

mkdir -p "$(dirname "$CREDS_FILE")" 2>/dev/null || fail "Could not create the config directory"

if [[ ${1:-} == "--clear" ]]; then
  rm -f "$CREDS_FILE" || fail "Could not remove the credentials file"
  rm -f "${XDG_RUNTIME_DIR:-/tmp}/omarchy-flight-radar/token"
  exit 0
fi

payload=$(cat)
[[ -n $payload ]] || fail "No credentials received"

client_id=$(printf '%s' "$payload" | jq -r '.clientId // empty' 2>/dev/null) ||
  fail "Credentials were not valid JSON"
client_secret=$(printf '%s' "$payload" | jq -r '.clientSecret // empty' 2>/dev/null) ||
  fail "Credentials were not valid JSON"

[[ -n $client_id ]] || fail "Client ID is empty"
[[ -n $client_secret ]] || fail "Client secret is empty"

install -m600 /dev/null "$CREDS_FILE" || fail "Could not create the credentials file"

if ! jq -n --arg id "$client_id" --arg secret "$client_secret" \
  '{clientId: $id, clientSecret: $secret}' >"$CREDS_FILE"; then
  rm -f "$CREDS_FILE"
  fail "Could not write the credentials file"
fi

rm -f "${XDG_RUNTIME_DIR:-/tmp}/omarchy-flight-radar/token"
